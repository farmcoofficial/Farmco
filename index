<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title> FARM CO. | Inspired by Nature. For Climate. For Our Future.</title>
  <meta name="description" content="FARM CO. is an experiential farming and agriculture-learning platform in India connecting urban communities, schools, families, and corporates with real farms and farmers." />
  <meta name="keywords" content="FARM CO., experiential farming India, agritourism Bengaluru, farm visits Karnataka, sustainable agriculture workshops, support Indian farmers, school farm trips, corporate farm retreat" />
  <meta name="author" content="Chandana V, FARM CO." />

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="FARM CO. — Reconnect With Nature. Experience Farming." />
  <meta property="og:description" content="Inspired by Nature. For Climate. For Our Future. Book authentic farm experiences or partner your farm with us." />
  <meta property="og:image" content="https://images.unsplash.com/photo-1753123198359-e69454f63a5c?auto=format&fit=crop&w=1600&q=80" />

  <!-- Google Fonts: Editorial Serif + Modern Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ==========================================================================
       1. DESIGN TOKENS & BASE STYLES
       ========================================================================== */
    :root {
      --forest-950: #0F2318;
      --forest-900: #173325;
      --forest-800: #1E4230;
      --forest-700: #2C5A42;
      --sage-500:   #4E745B;
      --sage-200:   #D9E4DC;
      --earth-800:  #523629;
      --earth-600:  #734C3A;
      --earth-400:  #A2745C;
      --cream-50:   #FAF7F0;
      --cream-100:  #F3EDE0;
      --beige-200:  #E7DEC9;
      --white:      #FFFFFF;
      --ink-900:    #1A211D;
      --ink-700:    #414D46;
      --ink-500:    #6A776F;
      --border:     rgba(23, 51, 37, 0.12);

      --font-serif: 'Cormorant Garamond', Georgia, serif;
      --font-sans:  'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;

      --radius-sm:  10px;
      --radius-md:  16px;
      --radius-lg:  22px;
      --radius-xl:  32px;

      --shadow-sm:  0 6px 20px rgba(15, 35, 24, 0.05);
      --shadow-md:  0 14px 36px rgba(15, 35, 24, 0.08);
      --shadow-lg:  0 24px 56px rgba(15, 35, 24, 0.14);

      --transition: 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      --container:  1220px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 86px;
      font-size: 16px;
    }

    body {
      font-family: var(--font-sans);
      color: var(--ink-900);
      background-color: var(--cream-50);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
      font-size: inherit;
    }

    .container {
      width: 100%;
      max-width: var(--container);
      margin: 0 auto;
      padding: 0 24px;
    }

    .section {
      padding: 96px 0;
      position: relative;
    }

    .section--cream { background-color: var(--cream-50); }
    .section--beige { background-color: var(--cream-100); }
    .section--white { background-color: var(--white); }
    .section--forest {
      background-color: var(--forest-900);
      color: var(--cream-50);
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--earth-600);
      margin-bottom: 14px;
    }

    .section--forest .eyebrow {
      color: var(--sage-200);
    }

    .eyebrow::before {
      content: "";
      width: 24px;
      height: 1.5px;
      background: currentColor;
      display: inline-block;
    }

    h1, h2, h3, .serif {
      font-family: var(--font-serif);
      font-weight: 600;
      line-height: 1.12;
      letter-spacing: -0.01em;
    }

    h2.section-title {
      font-size: clamp(2.1rem, 4vw, 3.2rem);
      color: var(--forest-900);
      margin-bottom: 18px;
    }

    .section--forest h2.section-title {
      color: var(--white);
    }

    .section-lead {
      font-size: 1.07rem;
      color: var(--ink-700);
      max-width: 660px;
    }

    .section--forest .section-lead {
      color: rgba(250, 247, 240, 0.84);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 26px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.94rem;
      cursor: pointer;
      border: 1.5px solid transparent;
      transition: transform var(--transition), background-color var(--transition), color var(--transition), border-color var(--transition), box-shadow var(--transition);
      white-space: nowrap;
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background-color: var(--forest-900);
      color: var(--white);
      box-shadow: 0 8px 20px rgba(23, 51, 37, 0.18);
    }

    .btn-primary:hover {
      background-color: var(--forest-800);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(23, 51, 37, 0.25);
    }

    .btn-light {
      background-color: var(--cream-50);
      color: var(--forest-900);
    }

    .btn-light:hover {
      background-color: var(--white);
      transform: translateY(-2px);
    }

    .btn-outline-light {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--white);
      border-color: rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(8px);
    }

    .btn-outline-light:hover {
      background-color: var(--white);
      color: var(--forest-900);
      transform: translateY(-2px);
    }

    .btn-outline {
      background-color: transparent;
      color: var(--forest-900);
      border-color: rgba(23, 51, 37, 0.28);
    }

    .btn-outline:hover {
      background-color: var(--forest-900);
      color: var(--white);
      border-color: var(--forest-900);
    }

    .btn-earth {
      background-color: var(--earth-600);
      color: var(--white);
    }

    .btn-earth:hover {
      background-color: var(--earth-800);
      transform: translateY(-2px);
    }

    .btn-whatsapp {
      background-color: #1F7A4C;
      color: var(--white);
    }

    .btn-whatsapp:hover {
      background-color: #18623D;
      transform: translateY(-2px);
    }

    .btn-sm {
      padding: 9px 18px;
      font-size: 0.85rem;
    }

    /* Scroll Reveal Animations */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       2. TOP NAVIGATION BAR
       ========================================================================== */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      transition: background-color var(--transition), box-shadow var(--transition), padding var(--transition);
      padding: 16px 0;
    }

    .site-header.scrolled {
      background-color: rgba(250, 247, 240, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow: 0 4px 24px rgba(15, 35, 24, 0.08);
      padding: 11px 0;
      border-bottom: 1px solid var(--border);
    }

    .nav-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      z-index: 1002;
    }

    .brand-mark {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background-color: var(--forest-900);
      color: var(--cream-50);
      display: grid;
      place-items: center;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.25);
      transition: background-color var(--transition);
    }

    .site-header:not(.scrolled) .brand-mark {
      background-color: rgba(15, 35, 24, 0.72);
      backdrop-filter: blur(6px);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.05;
    }

    .brand-name {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: 1.32rem;
      letter-spacing: 0.06em;
      color: var(--white);
      transition: color var(--transition);
    }

    .brand-sub {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.82);
      transition: color var(--transition);
    }

    .site-header.scrolled .brand-name {
      color: var(--forest-900);
    }

    .site-header.scrolled .brand-sub {
      color: var(--earth-600);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 22px;
      list-style: none;
    }

    .nav-links a {
      font-size: 0.89rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.92);
      position: relative;
      padding: 4px 0;
      transition: color var(--transition);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 1.5px;
      background: currentColor;
      transition: width var(--transition);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .site-header.scrolled .nav-links a {
      color: var(--ink-900);
    }

    .site-header.scrolled .nav-links a:hover {
      color: var(--forest-700);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .site-header:not(.scrolled) .nav-cta {
      background-color: var(--cream-50);
      color: var(--forest-900);
    }

    .site-header:not(.scrolled) .nav-cta:hover {
      background-color: var(--white);
    }

    .mobile-toggle {
      display: none;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.35);
      background: rgba(15, 35, 24, 0.45);
      color: var(--white);
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 1002;
    }

    .site-header.scrolled .mobile-toggle {
      color: var(--forest-900);
      background: var(--cream-100);
      border-color: var(--border);
    }

    .mobile-drawer {
      display: none;
      position: fixed;
      inset: 0;
      background: var(--forest-950);
      color: var(--cream-50);
      z-index: 1001;
      padding: 96px 28px 36px;
      flex-direction: column;
      justify-content: space-between;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .mobile-drawer.open {
      display: flex;
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-drawer ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .mobile-drawer a.mobile-link {
      font-family: var(--font-serif);
      font-size: 2rem;
      font-weight: 500;
      display: block;
      padding: 4px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* ==========================================================================
       3. HERO SECTION & PLATFORM INTRO
       ========================================================================== */
    .hero {
      position: relative;
      min-height: 94vh;
      display: flex;
      align-items: flex-end;
      padding: 130px 0 76px;
      overflow: hidden;
      background-color: var(--forest-950);
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 42%;
      transform: scale(1.03);
      transition: transform 8s ease;
    }

    .hero:hover .hero-bg {
      transform: scale(1.06);
    }

    .hero-scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(15, 35, 24, 0.58) 0%, rgba(15, 35, 24, 0.32) 45%, rgba(15, 35, 24, 0.88) 100%),
        linear-gradient(90deg, rgba(15, 35, 24, 0.72) 0%, rgba(15, 35, 24, 0.25) 65%, transparent 100%);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 820px;
      color: var(--white);
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      border-radius: 999px;
      background: rgba(250, 247, 240, 0.14);
      border: 1px solid rgba(250, 247, 240, 0.28);
      backdrop-filter: blur(10px);
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 22px;
      color: var(--cream-50);
    }

    .hero-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #98D8AA;
    }

    .hero h1 {
      font-size: clamp(2.85rem, 6vw, 4.9rem);
      font-weight: 600;
      line-height: 1.04;
      margin-bottom: 22px;
      color: var(--white);
    }

    .hero p.hero-sub {
      font-size: clamp(1.04rem, 1.5vw, 1.24rem);
      color: rgba(250, 247, 240, 0.9);
      max-width: 640px;
      margin-bottom: 34px;
      font-weight: 400;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 42px;
    }

    .hero-pillars {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      padding-top: 26px;
      border-top: 1px solid rgba(250, 247, 240, 0.22);
    }

    .hero-pillar-label {
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--sage-200);
      margin-bottom: 4px;
    }

    .hero-pillar-text {
      font-size: 0.92rem;
      color: rgba(255, 255, 255, 0.92);
      font-weight: 500;
    }

    /* Short Introduction Band */
    .intro-band {
      background: var(--white);
      border-bottom: 1px solid var(--border);
      padding: 64px 0;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1.1fr 1.4fr;
      gap: 48px;
      align-items: center;
    }

    .intro-quote {
      font-family: var(--font-serif);
      font-size: clamp(1.75rem, 2.8vw, 2.35rem);
      color: var(--forest-900);
      line-height: 1.2;
    }

    .intro-quote em {
      color: var(--earth-600);
      font-style: italic;
    }

    .intro-copy p {
      color: var(--ink-700);
      margin-bottom: 16px;
      font-size: 1.02rem;
    }

    .intro-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .intro-tag {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--forest-800);
      background: var(--cream-100);
      padding: 7px 14px;
      border-radius: 999px;
      border: 1px solid rgba(23, 51, 37, 0.08);
    }

    /* ==========================================================================
       4. EXPERIENCES SECTION
       ========================================================================== */
    .section-head-split {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }

    .sample-notice {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 12px;
      background: var(--cream-100);
      border: 1px solid rgba(115, 76, 58, 0.2);
      color: var(--earth-800);
      font-size: 0.84rem;
      font-weight: 500;
      margin-bottom: 28px;
    }

    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 34px;
    }

    .filter-btn {
      padding: 9px 18px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--white);
      color: var(--ink-700);
      font-size: 0.87rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition);
    }

    .filter-btn:hover {
      border-color: var(--forest-800);
      color: var(--forest-900);
    }

    .filter-btn.active {
      background: var(--forest-900);
      color: var(--white);
      border-color: var(--forest-900);
    }

    .experiences-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 26px;
    }

    .exp-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform var(--transition), box-shadow var(--transition);
    }

    .exp-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
    }

    .exp-media {
      position: relative;
      height: 235px;
      overflow: hidden;
      background-color: var(--sage-200);
    }

    .exp-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s ease;
    }

    .exp-card:hover .exp-media img {
      transform: scale(1.06);
    }

    .exp-badge-row {
      position: absolute;
      top: 14px;
      left: 14px;
      right: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      pointer-events: none;
    }

    .exp-sample-pill {
      background: rgba(15, 35, 24, 0.78);
      color: var(--cream-50);
      backdrop-filter: blur(8px);
      font-size: 0.71rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 5px 11px;
      border-radius: 999px;
    }

    .exp-duration-pill {
      background: rgba(255, 255, 255, 0.92);
      color: var(--forest-900);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 5px 11px;
      border-radius: 999px;
    }

    .exp-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .exp-meta {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--earth-600);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
    }

    .exp-title {
      font-family: var(--font-serif);
      font-size: 1.62rem;
      color: var(--forest-900);
      margin-bottom: 10px;
    }

    .exp-desc {
      color: var(--ink-700);
      font-size: 0.94rem;
      margin-bottom: 18px;
      flex: 1;
    }

    .exp-highlights {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 20px;
    }

    .exp-chip {
      font-size: 0.76rem;
      padding: 4px 10px;
      border-radius: 8px;
      background: var(--cream-50);
      border: 1px solid var(--border);
      color: var(--ink-700);
    }

    .exp-footer {
      padding-top: 16px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .exp-loc {
      font-size: 0.8rem;
      color: var(--ink-500);
    }

    /* ==========================================================================
       5. FOR FARMERS SECTION (CORE PLATFORM PILLAR)
       ========================================================================== */
    .farmers-layout {
      display: grid;
      grid-template-columns: 1fr 1.12fr;
      gap: 48px;
      align-items: start;
    }

    .farmers-benefits {
      display: grid;
      gap: 14px;
      margin: 28px 0 32px;
    }

    .benefit-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 16px 18px;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(250, 247, 240, 0.12);
    }

    .benefit-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(217, 228, 220, 0.14);
      color: var(--sage-200);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .benefit-item h4 {
      font-size: 1rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 2px;
    }

    .benefit-item p {
      font-size: 0.88rem;
      color: rgba(250, 247, 240, 0.76);
    }

    /* Forms Card */
    .form-card {
      background: var(--white);
      color: var(--ink-900);
      border-radius: var(--radius-xl);
      padding: 36px;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border);
    }

    .form-card-header {
      margin-bottom: 24px;
    }

    .form-card-header h3 {
      font-size: 1.85rem;
      color: var(--forest-900);
      margin-bottom: 6px;
    }

    .form-card-header p {
      font-size: 0.92rem;
      color: var(--ink-500);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    .form-label {
      font-size: 0.83rem;
      font-weight: 600;
      color: var(--forest-900);
    }

    .form-control {
      width: 100%;
      padding: 11px 14px;
      border-radius: var(--radius-sm);
      border: 1.5px solid rgba(23, 51, 37, 0.18);
      background: var(--cream-50);
      color: var(--ink-900);
      font-size: 0.93rem;
      transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
      outline: none;
      border-color: var(--forest-800);
      background: var(--white);
      box-shadow: 0 0 0 4px rgba(30, 66, 48, 0.08);
    }

    textarea.form-control {
      resize: vertical;
      min-height: 92px;
    }

    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px;
    }

    .check-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid rgba(23, 51, 37, 0.15);
      background: var(--cream-50);
      font-size: 0.84rem;
      cursor: pointer;
      user-select: none;
      transition: all 0.2s ease;
    }

    .check-pill:has(input:checked) {
      background: var(--sage-200);
      border-color: var(--forest-800);
      color: var(--forest-900);
      font-weight: 600;
    }

    .check-pill input {
      accent-color: var(--forest-900);
    }

    /* File Upload Dropzone */
    .upload-zone {
      border: 1.5px dashed rgba(23, 51, 37, 0.3);
      background: var(--cream-50);
      border-radius: var(--radius-md);
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    .upload-zone:hover, .upload-zone.dragover {
      border-color: var(--forest-800);
      background: var(--sage-200);
    }

    .upload-zone input {
      display: none;
    }

    .upload-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
      gap: 10px;
      margin-top: 12px;
    }

    .upload-thumb {
      position: relative;
      height: 70px;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border);
    }

    .upload-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .upload-thumb button {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      border: none;
      background: rgba(15, 35, 24, 0.8);
      color: #fff;
      font-size: 12px;
      cursor: pointer;
      display: grid;
      place-items: center;
    }

    .form-feedback {
      margin-top: 16px;
      padding: 18px;
      border-radius: var(--radius-md);
      background: #E6F2EA;
      border: 1px solid #9EC7AD;
      color: var(--forest-900);
      display: none;
    }

    .form-feedback.show {
      display: block;
      animation: fadeUp 0.35s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       6. WHY FARM CO.
       ========================================================================== */
    .why-grid {
      display: grid;
      grid-template-columns: 1.05fr 1.25fr;
      gap: 48px;
      align-items: center;
      margin-top: 32px;
    }

    .ecosystem-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .eco-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 22px;
      box-shadow: var(--shadow-sm);
      transition: transform var(--transition);
    }

    .eco-card:hover {
      transform: translateY(-4px);
    }

    .eco-num {
      font-family: var(--font-serif);
      font-size: 1.5rem;
      color: var(--earth-600);
      font-weight: 700;
      margin-bottom: 6px;
    }

    .eco-card h4 {
      font-size: 1.03rem;
      color: var(--forest-900);
      margin-bottom: 6px;
    }

    .eco-card p {
      font-size: 0.88rem;
      color: var(--ink-700);
    }

    .diff-box {
      background: var(--forest-900);
      color: var(--cream-50);
      border-radius: var(--radius-xl);
      padding: 38px;
      position: relative;
      overflow: hidden;
    }

    .diff-box h3 {
      font-size: 1.9rem;
      margin-bottom: 14px;
      color: var(--white);
    }

    .diff-list {
      list-style: none;
      display: grid;
      gap: 14px;
      margin-top: 22px;
    }

    .diff-list li {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 0.95rem;
      color: rgba(250, 247, 240, 0.88);
    }

    .diff-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(152, 216, 170, 0.2);
      color: #98D8AA;
      display: grid;
      place-items: center;
      flex-shrink: 0;
      margin-top: 2px;
      font-size: 0.78rem;
    }

    /* ==========================================================================
       7. OUR MISSION
       ========================================================================== */
    .mission-wrap {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: 54px;
      align-items: center;
    }

    .mission-media {
      position: relative;
      border-radius: var(--radius-xl);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      aspect-ratio: 4 / 4.6;
    }

    .mission-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .mission-caption {
      position: absolute;
      left: 20px;
      right: 20px;
      bottom: 20px;
      padding: 16px 20px;
      border-radius: var(--radius-md);
      background: rgba(15, 35, 24, 0.84);
      backdrop-filter: blur(10px);
      color: var(--cream-50);
      font-size: 0.88rem;
    }

    .mission-points {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 28px;
    }

    .mission-point {
      padding: 16px;
      border-radius: var(--radius-md);
      background: var(--cream-50);
      border: 1px solid var(--border);
    }

    .mission-point h4 {
      font-size: 0.96rem;
      color: var(--forest-900);
      margin-bottom: 4px;
    }

    .mission-point p {
      font-size: 0.84rem;
      color: var(--ink-700);
    }

    /* ==========================================================================
       8. HOW IT WORKS
       ========================================================================== */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
      margin-top: 42px;
    }

    .step-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 28px 24px;
      position: relative;
      box-shadow: var(--shadow-sm);
      transition: transform var(--transition);
    }

    .step-card:hover {
      transform: translateY(-4px);
    }

    .step-number {
      font-family: var(--font-serif);
      font-size: 2.6rem;
      font-weight: 700;
      color: var(--earth-400);
      line-height: 1;
      margin-bottom: 16px;
    }

    .step-card h3 {
      font-size: 1.5rem;
      color: var(--forest-900);
      margin-bottom: 10px;
    }

    .step-card p {
      font-size: 0.92rem;
      color: var(--ink-700);
    }

    /* ==========================================================================
       9. SCHOOLS & CORPORATE PARTNERSHIPS
       ========================================================================== */
    .partners-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      margin-top: 38px;
    }

    .partner-panel {
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: var(--white);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
    }

    .partner-banner {
      height: 220px;
      position: relative;
      overflow: hidden;
    }

    .partner-banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .partner-tag {
      position: absolute;
      bottom: 14px;
      left: 18px;
      padding: 6px 14px;
      border-radius: 999px;
      background: rgba(15, 35, 24, 0.85);
      color: var(--white);
      font-size: 0.76rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .partner-content {
      padding: 30px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .partner-content h3 {
      font-size: 1.85rem;
      color: var(--forest-900);
      margin-bottom: 12px;
    }

    .partner-bullets {
      list-style: none;
      display: grid;
      gap: 10px;
      margin: 18px 0 26px;
      flex: 1;
    }

    .partner-bullets li {
      padding-left: 20px;
      position: relative;
      font-size: 0.93rem;
      color: var(--ink-700);
    }

    .partner-bullets li::before {
      content: "•";
      position: absolute;
      left: 4px;
      color: var(--earth-600);
      font-weight: 700;
    }

    /* ==========================================================================
       10. CUSTOMER BOOKING SECTION
       ========================================================================== */
    .booking-layout {
      display: grid;
      grid-template-columns: 0.95fr 1.2fr;
      gap: 48px;
      align-items: start;
    }

    .booking-info-cards {
      display: grid;
      gap: 16px;
      margin-top: 28px;
    }

    .info-mini-card {
      padding: 20px;
      border-radius: var(--radius-md);
      background: var(--white);
      border: 1px solid var(--border);
    }

    .info-mini-card h4 {
      font-size: 1rem;
      color: var(--forest-900);
      margin-bottom: 4px;
    }

    .info-mini-card p {
      font-size: 0.89rem;
      color: var(--ink-700);
    }

    /* ==========================================================================
       11. FOUNDER SECTION
       ========================================================================== */
    .founder-card {
      background: var(--white);
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      padding: 52px;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 48px;
      align-items: center;
    }

    .founder-emblem {
      background: linear-gradient(155deg, var(--forest-900) 0%, var(--forest-700) 100%);
      color: var(--cream-50);
      border-radius: var(--radius-lg);
      padding: 42px 28px;
      text-align: center;
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .founder-monogram {
      width: 112px;
      height: 112px;
      margin: 0 auto 20px;
      border-radius: 50%;
      border: 1.5px solid rgba(250, 247, 240, 0.4);
      display: grid;
      place-items: center;
      font-family: var(--font-serif);
      font-size: 2.6rem;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.08);
    }

    .founder-emblem h3 {
      font-size: 1.8rem;
      color: var(--white);
      margin-bottom: 4px;
    }

    .founder-role {
      font-size: 0.84rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--sage-200);
    }

    .founder-loc {
      margin-top: 16px;
      font-size: 0.83rem;
      color: rgba(250, 247, 240, 0.78);
    }

    .founder-quote {
      font-family: var(--font-serif);
      font-size: clamp(1.5rem, 2.4vw, 2.05rem);
      line-height: 1.35;
      color: var(--forest-900);
      margin: 18px 0 24px;
    }

    .founder-sig {
      font-weight: 700;
      color: var(--earth-600);
      font-size: 0.95rem;
    }

    /* ==========================================================================
       12. CONTACT & GOOGLE MAPS INTEGRATION
       ========================================================================== */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 36px;
      margin-top: 36px;
    }

    .contact-details-card {
      background: var(--cream-50);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 34px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .contact-row {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    .contact-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: var(--forest-900);
      color: var(--cream-50);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .contact-row small {
      display: block;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-500);
      font-weight: 600;
    }

    .contact-row strong, .contact-row a {
      font-size: 1rem;
      color: var(--forest-900);
      font-weight: 600;
    }

    .map-card {
      margin-top: 32px;
      background: var(--cream-50);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 24px;
    }

    .map-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 16px;
    }

    .map-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .map-tab {
      padding: 7px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--white);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--ink-700);
      cursor: pointer;
    }

    .map-tab.active {
      background: var(--forest-900);
      color: var(--white);
      border-color: var(--forest-900);
    }

    .map-frame {
      width: 100%;
      height: 340px;
      border: 0;
      border-radius: var(--radius-md);
    }

    /* ==========================================================================
       13. FOOTER
       ========================================================================== */
    .site-footer {
      background: var(--forest-950);
      color: rgba(250, 247, 240, 0.82);
      padding: 72px 0 32px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 38px;
      padding-bottom: 44px;
      border-bottom: 1px solid rgba(250, 247, 240, 0.14);
    }

    .footer-brand {
      font-family: var(--font-serif);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .footer-tagline {
      color: var(--sage-200);
      font-size: 0.9rem;
      font-weight: 500;
      margin-bottom: 14px;
    }

    .footer-col h4 {
      color: var(--white);
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 16px;
    }

    .footer-links {
      list-style: none;
      display: grid;
      gap: 10px;
      font-size: 0.9rem;
    }

    .footer-links a, .footer-links button {
      color: rgba(250, 247, 240, 0.78);
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      text-align: left;
      transition: color 0.2s ease;
    }

    .footer-links a:hover, .footer-links button:hover {
      color: var(--white);
    }

    .social-row {
      display: flex;
      gap: 10px;
      margin-top: 16px;
    }

    .social-btn {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid rgba(250, 247, 240, 0.2);
      display: grid;
      place-items: center;
      color: var(--cream-50);
      transition: background-color 0.2s ease;
    }

    .social-btn:hover {
      background: rgba(250, 247, 240, 0.14);
    }

    .footer-bottom {
      padding-top: 24px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      font-size: 0.84rem;
      color: rgba(250, 247, 240, 0.64);
    }

    .footer-legal {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
    }

    .footer-legal button {
      background: none;
      border: none;
      color: rgba(250, 247, 240, 0.78);
      cursor: pointer;
      font-size: 0.84rem;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* ==========================================================================
       14. FLOATING WHATSAPP & MODALS (PRIVACY, TERMS, ENQUIRY MANAGER)
       ========================================================================== */
    .wa-float {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 950;
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 12px 18px;
      border-radius: 999px;
      background: #1B7A4A;
      color: var(--white);
      font-weight: 600;
      font-size: 0.88rem;
      box-shadow: 0 12px 30px rgba(15, 35, 24, 0.28);
      transition: transform 0.25s ease, background-color 0.25s ease;
    }

    .wa-float:hover {
      background: #15623B;
      transform: translateY(-3px);
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 35, 24, 0.72);
      backdrop-filter: blur(6px);
      z-index: 2000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.open {
      display: flex;
    }

    .modal-box {
      background: var(--white);
      color: var(--ink-900);
      width: 100%;
      max-width: 760px;
      max-height: 86vh;
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .modal-head {
      padding: 22px 28px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      background: var(--cream-50);
    }

    .modal-head h3 {
      font-size: 1.7rem;
      color: var(--forest-900);
    }

    .modal-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--white);
      cursor: pointer;
      font-size: 1.2rem;
      display: grid;
      place-items: center;
    }

    .modal-body {
      padding: 26px 28px;
      overflow-y: auto;
      font-size: 0.94rem;
      color: var(--ink-700);
    }

    .modal-body h4 {
      color: var(--forest-900);
      margin: 18px 0 6px;
      font-size: 1.05rem;
    }

    .enquiry-record {
      padding: 16px;
      border-radius: var(--radius-md);
      background: var(--cream-50);
      border: 1px solid var(--border);
      margin-bottom: 12px;
    }

    /* ==========================================================================
       15. RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 1080px) {
      .nav-links, .nav-actions .nav-cta {
        display: none;
      }
      .mobile-toggle {
        display: inline-flex;
      }
      .experiences-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .farmers-layout, .why-grid, .mission-wrap, .booking-layout, .contact-grid, .intro-grid {
        grid-template-columns: 1fr;
      }
      .founder-card {
        grid-template-columns: 1fr;
        padding: 34px;
      }
      .steps-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 720px) {
      .section {
        padding: 68px 0;
      }
      .hero {
        min-height: 88vh;
        padding: 112px 0 54px;
      }
      .hero-pillars {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .experiences-grid, .partners-grid, .steps-grid, .ecosystem-grid, .mission-points, .form-grid, .checkbox-grid, .footer-grid {
        grid-template-columns: 1fr;
      }
      .form-card {
        padding: 24px 20px;
      }
      .wa-float span {
        display: none;
      }
      .wa-float {
        padding: 14px;
      }
    }
  </style>
</head>
