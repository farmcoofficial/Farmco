          description: "Unplug from laptops for high-trust team building, collaborative farming challenges, sustainability workshops, and authentic rural community immersion.",
          highlights: ["Digital Detox", "Team Challenges", "ESG Alignment"],
          image: "https://images.unsplash.com/photo-1755227038952-ad89a85e7eef?auto=format&fit=crop&w=1200&q=80",
          alt: "Outdoor team gathering amidst lush greenery for corporate farm retreat"
        }
      ];

      /* --------------------------------------------------------------------
         2. RENDER EXPERIENCES + CATEGORY FILTERS
         -------------------------------------------------------------------- */
      const experiencesGrid = document.getElementById("experiencesGrid");
      const filterButtons = document.querySelectorAll(".filter-btn");
      const prefExperienceSelect = document.getElementById("prefExperience");

      function renderExperiences(filter = "all") {
        const items = filter === "all"
          ? EXPERIENCES_DATA
          : EXPERIENCES_DATA.filter((item) => item.category === filter);

        experiencesGrid.innerHTML = items.map((exp) => `
          <article class="exp-card">
            <div class="exp-media">
              <img src="${exp.image}" alt="${exp.alt}" loading="lazy" />
              <div class="exp-badge-row">
                <span class="exp-sample-pill">Sample Listing</span>
                <span class="exp-duration-pill">${exp.duration}</span>
              </div>
            </div>
            <div class="exp-body">
              <div class="exp-meta">${exp.sampleLocation}</div>
              <h3 class="exp-title">${exp.title}</h3>
              <p class="exp-desc">${exp.description}</p>
              <div class="exp-highlights">
                ${exp.highlights.map((tag) => `<span class="exp-chip">${tag}</span>`).join("")}
              </div>
              <div class="exp-footer">
                <span class="exp-loc">Onboarding Partner Farms</span>
                <button type="button" class="btn btn-primary btn-sm book-exp-btn" data-exp="${exp.title}">
                  Enquire / Book
                </button>
              </div>
            </div>
          </article>
        `).join("");

        // Wire card CTA buttons to booking form
        document.querySelectorAll(".book-exp-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            selectExperienceAndScroll(btn.getAttribute("data-exp"));
          });
        });
      }

      function selectExperienceAndScroll(experienceName) {
        if (prefExperienceSelect) {
          prefExperienceSelect.value = experienceName;
        }
        const bookingSection = document.getElementById("booking");
        bookingSection.scrollIntoView({ behavior: "smooth" });
        setTimeout(() => {
          document.getElementById("custName").focus();
        }, 500);
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterButtons.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          renderExperiences(btn.getAttribute("data-filter"));
        });
      });

      document.querySelectorAll(".partnership-cta").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectExperienceAndScroll(btn.getAttribute("data-experience"));
        });
      });

      renderExperiences("all");

      /* --------------------------------------------------------------------
         3. STICKY HEADER, MOBILE DRAWER & SCROLL REVEAL
         -------------------------------------------------------------------- */
      const header = document.getElementById("siteHeader");
      const mobileToggle = document.getElementById("mobileToggle");
      const mobileDrawer = document.getElementById("mobileDrawer");

      window.addEventListener("scroll", () => {
        header.classList.toggle("scrolled", window.scrollY > 40);
      }, { passive: true });

      function toggleDrawer(forceClose = false) {
        const isOpen = forceClose ? false : !mobileDrawer.classList.contains("open");
        mobileDrawer.classList.toggle("open", isOpen);
        mobileToggle.setAttribute("aria-expanded", String(isOpen));
        mobileDrawer.setAttribute("aria-hidden", String(!isOpen));
        document.body.style.overflow = isOpen ? "hidden" : "";
      }

      mobileToggle.addEventListener("click", () => toggleDrawer());
      document.querySelectorAll(".mobile-link, #mobileBookBtn").forEach((link) => {
        link.addEventListener("click", () => toggleDrawer(true));
      });

      // Scroll Reveal Observer
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));

      /* --------------------------------------------------------------------
         4. FARMER PHOTO UPLOAD PREVIEWS & FOCUS BUTTON
         -------------------------------------------------------------------- */
      const farmPhotosInput = document.getElementById("farmPhotos");
      const uploadDropzone = document.getElementById("uploadDropzone");
      const photoPreviewGrid = document.getElementById("photoPreviewGrid");
      let uploadedPhotos = [];

      function handleFiles(fileList) {
        const files = Array.from(fileList).slice(0, 5);
        photoPreviewGrid.innerHTML = "";
        uploadedPhotos = [];

        files.forEach((file, index) => {
          if (!file.type.startsWith("image/")) return;
          const reader = new FileReader();
          reader.onload = (e) => {
            const photoObj = {
              name: file.name,
              type: file.type,
              dataUrl: e.target.result
            };
            uploadedPhotos.push(photoObj);

            const div = document.createElement("div");
            div.className = "upload-thumb";
            div.innerHTML = `
              <img src="${e.target.result}" alt="Uploaded farm photo ${index + 1}" />
              <button type="button" title="Remove photo" aria-label="Remove photo">×</button>
            `;
            div.querySelector("button").addEventListener("click", () => {
              div.remove();
              uploadedPhotos = uploadedPhotos.filter((p) => p !== photoObj);
            });
            photoPreviewGrid.appendChild(div);
          };
          reader.readAsDataURL(file);
        });
      }

      farmPhotosInput.addEventListener("change", (e) => handleFiles(e.target.files));

      uploadDropzone.addEventListener("dragover", (e) => {
        e.preventDefault();
        uploadDropzone.classList.add("dragover");
      });
      uploadDropzone.addEventListener("dragleave", () => uploadDropzone.classList.remove("dragover"));
      uploadDropzone.addEventListener("drop", (e) => {
        e.preventDefault();
        uploadDropzone.classList.remove("dragover");
        handleFiles(e.dataTransfer.files);
      });

      document.getElementById("focusFarmerFormBtn").addEventListener("click", () => {
        document.getElementById("farmerFormCard").scrollIntoView({ behavior: "smooth" });
        setTimeout(() => document.getElementById("farmerName").focus(), 450);
      });

      /* --------------------------------------------------------------------
         5. ENQUIRY STORAGE & GOOGLE SHEETS SUBMISSION HANDLERS
         -------------------------------------------------------------------- */
      const STORAGE_KEY = "the_farm_co_submissions_v1";

      function getRecords() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
        } catch {
          return [];
        }
      }

      function saveRecord(record) {
        const records = getRecords();
        records.unshift({ ...record, id: Date.now(), createdAt: new Date().toLocaleString("en-IN") });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
      }

      // Sends form payload to Google Apps Script Web App
      async function sendToGoogleSheets(payload) {
        if (!SHEET_API) return;
        try {
          await fetch(SHEET_API.trim(), {
            method: "POST",
            mode: "no-cors", // Required for Google Apps Script cross-origin POSTs
            headers: {
              "Content-Type": "text/plain;charset=utf-8"
            },
            body: JSON.stringify(payload)
          });
        } catch (err) {
          console.error("Google Sheets sync error:", err);
        }
      }

      function sanitizePhone(phone) {
        return phone.replace(/\D/g, "");
      }

      function showFeedback(el, html, isError = false) {
        el.innerHTML = html;
        el.style.background = isError ? "#FDECEC" : "#E6F2EA";
        el.style.borderColor = isError ? "#E3A0A0" : "#9EC7AD";
        el.style.color = isError ? "#6E1E1E" : "#173325";
        el.classList.add("show");
      }

      // Set minimum date for booking date picker to today
      const prefDateInput = document.getElementById("prefDate");
      const todayISO = new Date().toISOString().split("T")[0];
      prefDateInput.setAttribute("min", todayISO);

      // A. Farmer Registration Submission
      const farmerForm = document.getElementById("farmerRegistrationForm");
      const farmerFeedback = document.getElementById("farmerFeedback");

      farmerForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const name = document.getElementById("farmerName").value.trim();
        const phone = document.getElementById("farmerPhone").value.trim();
        const location = document.getElementById("farmLocation").value.trim();
        const size = document.getElementById("farmSize").value.trim();
        const type = document.getElementById("farmingType").value;
        const activities = Array.from(document.querySelectorAll("#farmerActivities input:checked")).map((c) => c.value);

        if (!name || sanitizePhone(phone).length < 10 || !location || !size || !type) {
          showFeedback(farmerFeedback, "<strong>Please complete all required fields</strong> including a valid 10-digit phone number, location, farm size, and farming type.", true);
          return;
        }
        if (activities.length === 0) {
          showFeedback(farmerFeedback, "<strong>Select at least one activity</strong> your farm can host for visitors.", true);
          return;
        }

        const submitBtn = farmerForm.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting...";

        const recordForLocal = {
          recordType: "Farmer Registration",
          name,
          phone,
          location,
          farmSize: size,
          farmingType: type,
          activities,
          photosCount: uploadedPhotos.length
        };

        const recordForSheet = {
          ...recordForLocal,
          photos: uploadedPhotos
        };

        saveRecord(recordForLocal);
        await sendToGoogleSheets(recordForSheet);

        submitBtn.disabled = false;
        submitBtn.textContent = originalText;

        const waMsg = encodeURIComponent(
          `Namaste Farm Co., I am registering my farm.\nFarmer: ${name}\nPhone: ${phone}\nLocation: ${location}\nSize: ${size}\nType: ${type}\nActivities: ${activities.join(", ")}`
        );

        showFeedback(
          farmerFeedback,
          `<strong>Application Received! Thank you, ${name}.</strong><br/>
          Your farm partnership application for <em>${location}</em> has been recorded. Our onboarding team will call you at <strong>${phone}</strong> shortly.<br/>
          <a href="https://wa.me/${WHATSAPP_NUMBER}?text=${waMsg}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" style="margin-top:12px;">
            Also Send Application on WhatsApp
          </a>`
        );

        farmerForm.reset();
        photoPreviewGrid.innerHTML = "";
        uploadedPhotos = [];
      });

      // B. Customer Booking Enquiry Submission
      const bookingForm = document.getElementById("bookingForm");
      const bookingFeedback = document.getElementById("bookingFeedback");

      bookingForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const name = document.getElementById("custName").value.trim();
        const email = document.getElementById("custEmail").value.trim();
        const phone = document.getElementById("custPhone").value.trim();
        const experience = document.getElementById("prefExperience").value;
        const visitors = document.getElementById("visitorCount").value;
        const date = document.getElementById("prefDate").value;
        const location = document.getElementById("prefLocation").value.trim();
        const requirements = document.getElementById("addRequirements").value.trim();

        const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

        if (!name || !emailValid || sanitizePhone(phone).length < 10 || !experience || !visitors || !date || !location) {
          showFeedback(bookingFeedback, "<strong>Please fill in all required booking fields</strong> with a valid email address and 10-digit phone number.", true);
          return;
        }

        const submitBtn = bookingForm.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting...";

        const record = {
          recordType: "Booking Enquiry",
          name,
          email,
          phone,
          experience,
          visitors,
          preferredDate: date,
          location,
          requirements: requirements || "None specified"
        };

        saveRecord(record);
        await sendToGoogleSheets(record);

        submitBtn.disabled = false;
        submitBtn.textContent = originalText;

        const waMsg = encodeURIComponent(
          `Hello FARM CO., I submitted a booking enquiry:\nName: ${name}\nExperience: ${experience}\nVisitors: ${visitors}\nDate: ${date}\nLocation: ${location}\nPhone: ${phone}\nNotes: ${requirements || "N/A"}`
        );

        showFeedback(
          bookingFeedback,
          `<strong>Enquiry Submitted Successfully!</strong><br/>
          Thank you, <strong>${name}</strong>. Your request for <strong>${experience}</strong> (${visitors} visitor(s) on ${date}) has been received. Note: availability is confirmed after direct coordination with our partner farm.<br/>
          <a href="https://wa.me/${WHATSAPP_NUMBER}?text=${waMsg}" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm" style="margin-top:12px;">
            Fast-Track via WhatsApp
          </a>`
        );

        bookingForm.reset();
      });

      // C. General Contact Form Submission
      const contactForm = document.getElementById("contactForm");
      const contactFeedback = document.getElementById("contactFeedback");

      contactForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const name = document.getElementById("contactName").value.trim();
        const contact = document.getElementById("contactPhoneEmail").value.trim();
        const topic = document.getElementById("contactSubject").value;
        const message = document.getElementById("contactMsg").value.trim();

        if (!name || !contact || !message) {
          showFeedback(contactFeedback, "<strong>Please complete your name, contact info, and message.</strong>", true);
          return;
        }

        const submitBtn = contactForm.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        const record = {
          recordType: "Contact Message",
          name,
          contact,
          topic,
          message
        };

        saveRecord(record);
        await sendToGoogleSheets(record);

        submitBtn.disabled = false;
        submitBtn.textContent = originalText;

        showFeedback(
          contactFeedback,
          `<strong>Message Sent!</strong> Thank you, ${name}. Chandana V & FARM CO. team will respond to <strong>${contact}</strong> shortly.`
        );
        contactForm.reset();
      });      /* --------------------------------------------------------------------
         6. GOOGLE MAPS REGION SWITCHER
         -------------------------------------------------------------------- */
      const mapFrame = document.getElementById("googleMapFrame");
      document.querySelectorAll(".map-tab").forEach((tab) => {
        tab.addEventListener("click", () => {
          document.querySelectorAll(".map-tab").forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
          const query = encodeURIComponent(tab.getAttribute("data-query"));
          mapFrame.src = `https://maps.google.com/maps?q=${query}&t=&z=11&ie=UTF8&iwloc=&output=embed`;
        });
      });

      /* --------------------------------------------------------------------
         7. MODALS (PRIVACY, TERMS, LOCAL ENQUIRY MANAGER)
         -------------------------------------------------------------------- */
      function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
          modal.classList.add("open");
          document.body.style.overflow = "hidden";
        }
      }

      function closeAllModals() {
        document.querySelectorAll(".modal-backdrop.open").forEach((m) => m.classList.remove("open"));
        document.body.style.overflow = "";
      }

      document.querySelectorAll("[data-modal]").forEach((trigger) => {
        trigger.addEventListener("click", () => openModal(trigger.getAttribute("data-modal")));
      });

      document.querySelectorAll("[data-close-modal]").forEach((btn) => {
        btn.addEventListener("click", closeAllModals);
      });

      document.querySelectorAll(".modal-backdrop").forEach((backdrop) => {
        backdrop.addEventListener("click", (e) => {
          if (e.target === backdrop) closeAllModals();
        });
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAllModals();
      });

      // Local Enquiry Manager Rendering
      const enquiryListContainer = document.getElementById("enquiryListContainer");
      function renderEnquiryManager() {
        const records = getRecords();
        if (records.length === 0) {
          enquiryListContainer.innerHTML = `<p style="color:var(--ink-500);">No enquiries or farmer registrations have been submitted in this browser yet.</p>`;
          return;
        }
        enquiryListContainer.innerHTML = records.map((r) => `
          <div class="enquiry-record">
            <div style="display:flex; justify-content:space-between; gap:8px; margin-bottom:6px;">
              <strong style="color:var(--forest-900);">${r.recordType} — ${r.name}</strong>
              <small style="color:var(--ink-500);">${r.createdAt}</small>
            </div>
            <div style="font-size:0.86rem; color:var(--ink-700);">
              ${Object.entries(r)
                .filter(([k]) => !["id", "createdAt", "recordType", "name"].includes(k))
                .map(([k, v]) => `<div><strong>${k}:</strong> ${Array.isArray(v) ? v.join(", ") : v}</div>`)
                .join("")}
            </div>
          </div>
        `).join("");
      }

      document.getElementById("openEnquiryManagerBtn").addEventListener("click", () => {
        renderEnquiryManager();
        openModal("enquiryModal");
      });

      document.getElementById("exportEnquiriesBtn").addEventListener("click", () => {
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(getRecords(), null, 2));
        const a = document.createElement("a");
        a.setAttribute("href", dataStr);
        a.setAttribute("download", "farm-co-enquiries.json");
        document.body.appendChild(a);
        a.click();
        a.remove();
      });

      document.getElementById("clearEnquiriesBtn").addEventListener("click", () => {
        localStorage.removeItem(STORAGE_KEY);
        renderEnquiryManager();
      });

      // Footer Copyright Year
      document.getElementById("yearNow").textContent = new Date().getFullYear();
    })();
  </script>
</body>
</html>
